{
  "name": "@remoteai/i18n",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.tsx",
    "./common": "./src/catalogs/common/index.ts",
    "./desktop": "./src/catalogs/desktop/index.ts",
    "./coze": "./src/catalogs/coze/index.ts",
    "./website": "./src/catalogs/website/index.ts",
    "./catalogs/*": "./src/catalogs/*/index.ts",
    "./legacy": "./src/legacy/index.ts",
    "./legacy/resources/en": "./src/legacy/resources/en/index.ts",
    "./legacy/resources/ru": "./src/legacy/resources/ru/index.ts",
    "./legacy/resources/backend": "./src/legacy/resources/backend/index.ts",
    "./legacy/resources/en/desktop": "./src/legacy/resources/en/desktop/index.ts",
